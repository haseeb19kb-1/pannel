# =============================================================================
# StreamAdmin — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Vercel:
#   Add the needed variables under: Project Settings -> Environment Variables
# =============================================================================

# --- 1. Supabase Database & Auth (Optional - for real backend persistence) ---
# When left empty or default, the panel runs in demo mock-data mode automatically.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- 2. Agora RTC Engine (Optional - for Live Video & Audio Streaming) ---
# Used in RTC Streaming settings and live room token generation.
VITE_AGORA_APP_ID=98d7fa2490b84c8fb23a9d187265aef4
VITE_AGORA_APP_CERTIFICATE=b78a9c804f9842a698cd837691823ab4
VITE_AGORA_TOKEN_SERVER_URL=https://rtc-token.streamadmin.live/api/v1/rtc-token

# --- 3. AWS S3 Cloud Recording (Optional) ---
# Used for stream recording backups.
VITE_AWS_S3_BUCKET=streamadmin-live-recordings-prod
VITE_AWS_S3_REGION=ap-southeast-1

# --- 4. Application Configuration (Optional) ---
VITE_APP_NAME=StreamAdmin
VITE_API_BASE_URL=https://api.streamlive.net/v1
